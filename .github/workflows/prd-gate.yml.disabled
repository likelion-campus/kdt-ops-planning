# v1 한계 ⑤ "디자인 병렬 진행/재작업" 차단:
# PRD frontmatter status가 'ready-for-dev' 인 경우
#   - figma-links.yml 에 해당 screen 매핑 존재
#   - 3-backend/api-contract.yml 에 관련 endpoint 정의
# 둘 다 만족하지 않으면 PR fail.

name: prd-gate

on:
  pull_request:
    paths:
      - 'campfire/1-planning/prd/**'
      - 'classroom/1-planning/prd/**'

jobs:
  gate:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - run: npm install --no-save gray-matter js-yaml glob
      - run: node scripts/check-prd-gate.mjs
